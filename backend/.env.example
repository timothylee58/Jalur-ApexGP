OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# OpenF1 (openf1.org) — free, keyless historical F1 telemetry. No key
# needed; override only if you're pointing this at a mirror/proxy.
OPENF1_BASE_URL=https://api.openf1.org/v1

# Local dev default — a file-based store on disk, fine for localhost.
# On Vercel this must point somewhere durable (the function's filesystem
# doesn't persist between invocations): use Databricks Community Edition's
# free hosted MLflow tracking (https://community.cloud.databricks.com),
# then set:
#   MLFLOW_TRACKING_URI=databricks
#   DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
#   DATABRICKS_TOKEN=<a personal access token>
#   MLFLOW_EXPERIMENT_NAME=/Users/<your-databricks-login-email>/jalur-apexgp-predictions
# Databricks requires an absolute workspace path for the experiment name —
# a bare name (the local-dev default) only works against a "file:" store.
MLFLOW_TRACKING_URI=file:./ml/mlruns
MLFLOW_EXPERIMENT_NAME=jalur-apexgp-predictions
DATABRICKS_HOST=
DATABRICKS_TOKEN=

SEPANG_LAT=2.7608
SEPANG_LON=101.7381
FRONTEND_ORIGIN=http://localhost:3000
PORT=8000
