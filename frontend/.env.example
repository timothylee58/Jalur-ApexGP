# Base URL for the FastAPI backend, WITH the /api suffix — its routes are
# mounted under /api (matching Vercel's zero-config FastAPI convention),
# baked into the app itself rather than being deploy-specific, so this
# suffix is needed locally too, not just in production.
# Production: https://<your-backend-project>.vercel.app/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
